#!/usr/bin/env bash
# Builds Popamp Plus into Popamp's Flatpak repository, from a checkout of
# popamp/popamp, and signs it: the new commit on the branch "stable", the
# summary, the appstream data. The commit before it stays, with a static
# delta from it, so an update downloads only what changed; older ones go.
#
# Usage: bin/build-flatpak-repo <popamp checkout> <repo dir> <gpg key id> [subject [body]]
#   The repo dir may hold the repository as published, or not exist yet.
#   The subject and body go into the commit's message, which
#   `flatpak info` shows to whoever installed it: where it was built from.
#   The key, with its secret part, must be in gpg's keyring ($GNUPGHOME).
# Needs: flatpak, flatpak-builder, and the remote "flathub" for the
# runtime and the Rust SDK extension (installed for the user). The build
# goes into the current directory, not /tmp: a flatpak-builder that runs
# as the Flatpak org.flatpak.Builder has a /tmp of its own.
set -euo pipefail

die() { echo "error: $*" >&2; exit 1; }

[ $# -ge 3 ] && [ $# -le 5 ] || die "usage: $0 <popamp checkout> <repo dir> <gpg key id> [subject [body]]"
src=$1
repo=$2
key=$3
message=()
[ -z "${4:-}" ] || message+=(--subject="$4")
[ -z "${5:-}" ] || message+=(--body="$5")
manifest=$src/packaging/flatpak/io.github.popamp.popamp.yml
[ -f "$manifest" ] || die "$manifest: no Flatpak manifest in this checkout"
sign=(--gpg-sign="$key" ${GNUPGHOME:+--gpg-homedir="$GNUPGHOME"})

build=$(mktemp -d "$PWD/.flatpak-build.XXXXXX")
trap 'rm -rf "$build"' EXIT

# The host's flatpak installs what the build needs and signs: a
# flatpak-builder in a sandbox finds no refs on flathub, and its gpg never
# sees the key. The manifest names the runtime and the SDK extensions.
version=$(sed -nE "s/^runtime-version: *'?([^' ]+)'?.*/\1/p" "$manifest")
extensions=$(awk '/^sdk-extensions:/ { on = 1; next } on && /^ *- / { print $2; next } { on = 0 }' "$manifest")
[ -n "$version" ] || die "$manifest: no runtime-version"
deps=(org.freedesktop.Sdk//"$version" org.freedesktop.Platform//"$version")
for e in $extensions; do deps+=("$e//$version"); done
flatpak --user install -y --noninteractive flathub "${deps[@]}"

flatpak-builder --user --disable-rofiles-fuse \
    --default-branch=stable --repo="$repo" "${message[@]}" \
    --state-dir="$build/state" "$build/app" "$manifest"
flatpak build-sign "${sign[@]}" "$repo" io.github.popamp.popamp stable
flatpak build-update-repo "${sign[@]}" --title=Popamp --default-branch=stable \
    --prune --prune-depth=1 --generate-static-deltas "$repo"
